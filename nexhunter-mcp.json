{
  "mcpServers": {
    "nexhunter": {
      "type": "local",
      "command": "/path/to/nexhunter/.venv/bin/python",
      "args": [
        "-m",
        "nexhunter.api.mcp",
        "--server",
        "http://127.0.0.1:8888",
        "--profile",
        "nexhunter-web",
        "--tool-limit",
        "40"
      ],
      "enabled": true,
      "timeout": 600000,
      "alwaysAllow": []
    }
  }
}
