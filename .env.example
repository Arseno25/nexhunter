# NexHunter Configuration
# Copy this to .env and update values as needed

# Core Settings
NEXHUNTER_ENVIRONMENT=development

# Server Binding
NEXHUNTER_BIND_HOST=127.0.0.1
NEXHUNTER_BIND_PORT=8888
NEXHUNTER_EXTERNAL_BIND_ALLOWED=false

# Data Storage
NEXHUNTER_DATA_DIR=./nexhunter_data

# Logging
NEXHUNTER_LOG_LEVEL=INFO

# Request Limits
NEXHUNTER_MAX_REQUEST_BYTES=1048576
NEXHUNTER_MAX_OUTPUT_BYTES=10485760
NEXHUNTER_DEFAULT_TIMEOUT=300
NEXHUNTER_PROCESS_TERMINATION_GRACE=5

# Caching (result cache on the single execution path; deterministic terminal
# results only). TTL in seconds, 0 disables expiry. Stats at /api/cache/stats.
NEXHUNTER_CACHE_ENABLED=true
NEXHUNTER_CACHE_TTL=300
NEXHUNTER_CACHE_MAX_ENTRIES=256

# Feature Flags
NEXHUNTER_DESTRUCTIVE_TOOLS_ENABLED=false
NEXHUNTER_INTRUSIVE_TOOLS_ENABLED=false

# MCP Bridge (flags on `python -m nexhunter.api.mcp` override these)
NEXHUNTER_MCP_PROFILE=nexhunter-full
NEXHUNTER_MCP_TOOL_LIMIT=            # cap tools listed to a client; empty = no cap
NEXHUNTER_MCP_MAX_OUTPUT=4000        # characters of tool output sent per call
NEXHUNTER_MCP_ASYNC_THRESHOLD=120    # tool timeout (s) at/above which a call runs as a background job

# Adaptive Parallel Worker Scaling (requires optional `psutil`; without it,
# execution always runs at NEXHUNTER_MAX_WORKERS)
NEXHUNTER_MIN_WORKERS=2              # floor when the machine is under load
NEXHUNTER_MAX_WORKERS=4              # baseline worker count
NEXHUNTER_WORKERS_CEILING=           # cap when load is low; empty = min(32, max(4, cpu_count*2))
NEXHUNTER_WORKER_CPU_HI=85           # % CPU at/above which worker count shrinks toward the floor
NEXHUNTER_WORKER_CPU_LO=50           # % CPU below which worker count grows toward the ceiling
NEXHUNTER_WORKER_MEM_HI=90           # % memory at/above which worker count shrinks toward the floor

# File-input containment (semicolon-separated paths the params layer may read)
NEXHUNTER_ALLOWED_PATHS=
